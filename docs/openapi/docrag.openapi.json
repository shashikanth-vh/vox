        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Extract one PDF/XLSX to structured Markdown (synchronous, cached)",
        "tags": [
          "DocRAG"
        ]
      }
