    "/v1/extract": {
      "post": {
        "description": "The document's content as Markdown \u2014 headings, real tables, ``[page N]``\nmarkers \u2014 plus the engines used and every warning (a scanned page with no OCR\nis named, never silently empty). Nothing is indexed. Identical files are served\nfrom cache; a scan that needs Sarvam can take minutes the first time.",
        "operationId": "extract_v1_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_v1_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Extract V1 Extract Post",
