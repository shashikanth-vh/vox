{
  "components": {
    "schemas": {
      "Body_extract_v1_extract_post": {
        "properties": {
          "file": {
            "format": "binary",
            "title": "File",
            "type": "string"
          },
          "use_sarvam": {
            "default": true,
            "title": "Use Sarvam",
            "type": "boolean"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_extract_v1_extract_post",
        "type": "object"
      },
      "Body_upload_v1_documents_post": {
        "properties": {
          "file": {
            "format": "binary",
            "title": "File",
            "type": "string"
          },
          "use_sarvam": {
            "default": true,
            "title": "Use Sarvam",
            "type": "boolean"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_v1_documents_post",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QueryIn": {
        "additionalProperties": false,
        "properties": {
          "doc_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "title": "Doc Ids",
            "type": "array"
          },
          "mode": {
            "default": "extractive",
            "enum": [
              "extractive",
              "generative"
            ],
            "title": "Mode",
            "type": "string"
          },
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "top_k": {
            "default": 5,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "QueryIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "One of DOCRAG_API_KEYS (injected by the gateway inside PRISM).",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "description": "Alternative to X-API-Key when calling directly.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Document \u2192 knowledge \u2192 hybrid retrieval with cited answers.",
    "title": "PRISM DocRAG",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
