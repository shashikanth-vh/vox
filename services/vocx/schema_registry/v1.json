  "asset_monetisation": {
   "label": "Asset monetisation",
   "ui_note": "Branches on party_role — the first determination is always which side of the table the counterparty sits on. 'Both' renders the owner block and the buyer block together, in that order. All fields beyond party_role are optional.",
   "fields": [
    {
     "key": "party_role",
     "label": "Party role",
     "type": "enum",
     "control": "dropdown",
     "applies_to": "always",
     "options": [
      {
       "value": "owner",
       "label": "Asset owner (selling)"
      },
      {
       "value": "buyer",
       "label": "Asset buyer (acquiring)"
      },
      {
       "value": "both",
       "label": "Both"
      }
     ],
     "notes": "First question, always."
    },
    {
     "key": "deal_size",
     "label": "Deal size",
     "type": "string",
     "control": "text",
     "applies_to": "always",
     "notes": "Free text (₹ / EV, indicative) — owner-decided as free text, not a parsed number."
    },
    {
     "key": "offer_components",
     "label": "Offer components",
     "type": "list",
     "control": "chips",
     "applies_to": "owner",
     "closed_set": [
      "entire_project",
      "land",
      "ppa",
      "connectivity",
      "modules",
      "epc_contract"
     ],
     "allow_free_text": true,
     "notes": "Closed set plus free-text additions stored as extra strings in the same array."
    },
    {
     "key": "asset_status",
     "label": "Asset status",
     "type": "enum",
     "control": "dropdown",
     "applies_to": "owner",
     "options": [
      {
       "value": "operational",
       "label": "Operational"
      },
      {
       "value": "shovel_ready",
       "label": "Shovel-ready"
      },
      {
       "value": "under_construction",
       "label": "Under construction"
      },
      {
       "value": "other",
       "label": "Other"
      }
     ]
    },
    {
     "key": "offer_notes",
     "label": "Offer notes",
     "type": "string",
     "control": "textarea",
     "applies_to": "owner"
    },
    {
     "key": "target_project_size",
     "label": "Target project size",
     "type": "string",
     "control": "text",
     "applies_to": "buyer",
     "notes": "e.g. \"20–50 MW operational\"."
    },
    {
     "key": "valuation_approach",
     "label": "Valuation approach",
     "type": "string",
     "control": "text",
     "applies_to": "buyer",
     "notes": "e.g. DCF at 11% equity IRR / EV per MW."
    },
    {
     "key": "buyer_criteria",
     "label": "Buyer criteria",
     "type": "list",
     "control": "list",
     "applies_to": "buyer",
     "notes": "Each a criterion as spoken. Flat strings in v1; structured objects are a later registry version, not a v1 gap."
    },
    {
     "key": "remarks",
     "label": "Remarks",
     "type": "string",
     "control": "textarea",
     "applies_to": "always"
    }
   ]
  },
