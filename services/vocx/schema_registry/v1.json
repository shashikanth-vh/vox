{
 "registry_version": "v1",
 "description": "VOX field registry — the single source every other component derives from: the AI prompt, the schema contract validator, and the review renderer. Change something here and you change it everywhere (Build Specification, Section 9). Machine names are the JSON keys; labels are the UI copy.",
 "use_cases": [
  "lending",
  "syndication",
  "asset_monetisation",
  "credit_diligence",
  "investor_relations",
  "banking_relations",
  "operations"
 ],
 "confidence_levels": [
  "high",
  "medium",
  "low",
  "n/a"
 ],
 "cross_cutting_rules": [
  "a conversation may carry multiple use cases",
  "sector/subsector are available on all use cases, always nullable, never forced",
  "null numeric values raise a data-quality flag but never block submit",
  "judgement fields are always review-recommended regardless of confidence",
  "labels are human-readable; enums render as dropdowns"
 ],
 "common": [
  {
   "key": "meeting_type",
   "label": "Meeting type",
   "type": "enum",
   "control": "dropdown",
   "options": [
    {
     "value": "in_person",
     "label": "In person"
    },
    {
     "value": "call",
     "label": "Call"
    },
    {
     "value": "video",
     "label": "Video"
    },
    {
     "value": "other",
     "label": "Other"
    }
   ]
  },
  {
   "key": "meeting_date",
   "label": "Meeting date",
   "type": "date",
   "control": "date",
   "notes": "Null if not stated."
  },
  {
   "key": "location",
   "label": "Location",
   "type": "string",
   "control": "text",
   "notes": "City/site/place as spoken. Distinct from the auto-captured GPS."
  },
  {
   "key": "sector",
   "label": "Sector",
   "type": "enum",
   "control": "dropdown",
   "options_from": "taxonomy.sectors",
   "notes": "Always nullable; never forced."
  },
  {
   "key": "subsector",
   "label": "Subsector",
   "type": "enum",
   "control": "dropdown",
   "options_from": "taxonomy.subsectors_of_selected_sector",
   "notes": "Offered only under its parent sector; drives the per-subsector canonical fields."
  },
  {
   "key": "attendees_counterparty",
   "label": "Attendees (their side)",
   "type": "list",
   "control": "list",
   "notes": "Names/roles on the other side, as heard."
  },
  {
   "key": "key_discussion_points",
   "label": "Key discussion points",
   "type": "list",
   "control": "list"
  },
  {
   "key": "meeting_summary",
   "label": "Summary",
   "type": "string",
   "control": "textarea",
   "judgement": true,
   "notes": "A 2-4 sentence narrative of the meeting: who met whom (names and roles), where, and each distinct thread discussed with its headline numbers — written like a colleague's crisp debrief, e.g. 'Kannan met R. Sharma (MD, Suryodaya EPC) in Whitefield. Three threads: a ₹25 Cr project-finance requirement...'. Confidence n/a."
  },
  {
   "key": "action_items",
   "label": "Action items",
   "type": "list",
   "control": "action_items",
   "item_shape": {
    "action": "string",
    "owner": "string|null",
    "deadline": "date|null"
   }
  },
  {
   "key": "next_steps",
   "label": "Next steps",
   "type": "string",
   "control": "text"
  },
  {
   "key": "follow_up_date",
   "label": "Follow-up date",
   "type": "date",
   "control": "date",
   "notes": "Feeds the confirm-then-create calendar draft."
  },
  {
   "key": "follow_up_time",
   "label": "Follow-up time",
   "type": "string",
   "control": "text",
   "notes": "Time of the follow-up in 24-hour HH:MM, only when a time was actually spoken ('11am' -> '11:00'). Null when only a date was mentioned."
  },
  {
   "key": "opportunity_assessment",
   "label": "Opportunity assessment",
   "type": "string",
   "control": "textarea",
   "judgement": true,
   "notes": "Your read. Always review-recommended; confidence n/a."
  },
  {
   "key": "opportunity_score",
   "label": "Opportunity score",
   "type": "int",
   "control": "score",
   "min": 1,
   "max": 5,
   "notes": "AI suggests with confidence; the recorder may override at review. Null is valid. On override, confidence becomes n/a and user_override flips true. Never a required needs-you item."
  },
  {
   "key": "opportunity_score_override_reason",
   "label": "Reason for change (optional)",
   "type": "string",
   "control": "textarea",
   "judgement": true,
   "notes": "Optional free-text reason when the score is changed. Stored for audit only; never compulsory, never blocks submit."
  },
  {
   "key": "competitive_intelligence",
   "label": "Competitive intelligence",
   "type": "string",
   "control": "textarea",
   "judgement": true,
   "notes": "Rival quotes/positions. Always review-recommended; confidence n/a."
  },
  {
   "key": "data_quality_flags",
   "label": "Data quality flags",
   "type": "list",
   "control": "list",
   "system": true,
   "notes": "What was missing or vague. Confidence n/a."
  }
 ],
