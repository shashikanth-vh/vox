# Copy to .env for local runs. All settings are read with the REGISTER_ prefix.

# --- environment ---
REGISTER_ENVIRONMENT=local
REGISTER_DEBUG=false
REGISTER_LOG_LEVEL=INFO
REGISTER_LOG_JSON=false

# --- HTTP ---
REGISTER_HOST=0.0.0.0
REGISTER_PORT=8000
# Comma-separated list; leave empty to disable CORS.
REGISTER_CORS_ORIGINS=

# --- database ---
REGISTER_DB_HOST=localhost
REGISTER_DB_PORT=5432
REGISTER_DB_NAME=register
REGISTER_DB_USER=register
REGISTER_DB_PASSWORD=register
# Or supply a full DSN (overrides the parts above):
# REGISTER_DATABASE_URL=postgresql+asyncpg://register:register@localhost:5432/register

# --- connection pool (bound so parallel load can't exhaust PostgreSQL) ---
REGISTER_DB_POOL_SIZE=20
REGISTER_DB_MAX_OVERFLOW=10
REGISTER_DB_POOL_TIMEOUT_S=30
REGISTER_DB_STATEMENT_TIMEOUT_MS=30000
REGISTER_DB_LOCK_TIMEOUT_MS=10000
REGISTER_DB_IDLE_IN_TXN_TIMEOUT_MS=60000
# Transparent retry of transient DB failures (deadlock / serialization / dropped conn).
REGISTER_DB_RETRY_MAX_ATTEMPTS=3
REGISTER_DB_RETRY_BASE_DELAY_MS=50

# --- security (light by design; user management lives upstream) ---
REGISTER_API_KEYS=dev-local-key
REGISTER_REQUIRE_API_KEY=true
REGISTER_DEFAULT_TENANT_CODE=EVAM
REGISTER_ENFORCE_RLS=false

# --- behaviour ---
REGISTER_DEFAULT_PAGE_SIZE=50
REGISTER_MAX_PAGE_SIZE=200
REGISTER_IDEMPOTENCY_TTL_HOURS=48

# --- gunicorn (container) ---
REGISTER_WEB_CONCURRENCY=4
REGISTER_WORKER_TIMEOUT=60
