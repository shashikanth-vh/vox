# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# Local UI builds used to drive the shipped bundle in a browser — never shipped.
dist-live/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local config / secrets
.env
*.local

# Real data must never be committed — operators load it at runtime (see README).
# The synthetic prototype mock (services/register/data/atlas_data.json) is intentionally kept.
services/register/data/*.xlsx
services/register/data/*.xlsm
services/register/data/*.csv

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# TLS material for the local edge — generated by scripts/gen_dev_certs.sh.
# NEVER commit a private key, not even a self-signed dev one.
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep
!deploy/nginx/certs/README.md

# VocX secrets — NEVER commit: Google OAuth client + per-RM refresh tokens.
client_secret.json
*.token.json
vocx_tokens/
deploy/vocx-secrets/*
!deploy/vocx-secrets/README.md

# Frontend
node_modules/

# VocX capture archive written by a local test run — recordings are never committed.
services/vocx/captures/
