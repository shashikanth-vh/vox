# Chitti instance — standalone production deployment.
# Copy to .env.chitti, restrict permissions with chmod 600 .env.chitti,
# and replace every placeholder before starting the service.
# For both projects on one machine, use its private/LAN IP in both addresses.
CHITTI_BIND_IP=<chitti-instance-private-ip>
CHITTI_REGISTER_BASE_URL=https://<services-certificate-hostname>:8443/machine
CHITTI_REGISTER_CA_FILE=/etc/chitti/tls.crt
# Chitti-side server certificate/key; certificate SAN must match GATEWAY_CHITTI_URL.
CHITTI_TLS_CERT_FILE=/etc/chitti/chitti.crt
CHITTI_TLS_KEY_FILE=/etc/chitti/chitti.key
CHITTI_HTTPS_PORT=8443

# Generate two distinct keys with openssl rand -hex 32.
# Match these values in the services instance's .env.
CHITTI_GATEWAY_KEY=<gateway-to-chitti-key>
SVC_CHITTI_KEY=<register-chitti-service-key>

# Copy the existing signing secret from the services instance; do not rotate it.
INTERNAL_SIGNING_SECRET=<existing-shared-signing-secret>

# Bedrock API key; endpoint and model defaults are in the standalone Compose file.
CHITTI_LLM_API_KEY=<bedrock-api-key>

# DocRAG on this host. Generate both with openssl rand -hex 32; DOCRAG_FRONT_KEY must
# match DOCRAG_FRONT_KEY in the services instance's .env (its gateway and orchestrator
# send it). DOCRAG_QDRANT_API_KEY stays on this host.
DOCRAG_FRONT_KEY=<services-to-docrag-key>
DOCRAG_QDRANT_API_KEY=<docrag-qdrant-key>
# Optional: OCR for scanned PDFs and images (Sarvam Doc AI). Blank = scans flagged, not read.
SARVAM_API_KEY=<sarvam-api-key>
