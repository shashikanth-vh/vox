# Copy to .env and replace credential placeholders and example domains before deployment.
# ---- core secrets (MANDATORY to change for production) ----------------------
PRISM_DB_PASSWORD=<REPLACE_PRISM_DB_PASSWORD>
MINIO_ROOT_USER=prism-minio
MINIO_ROOT_PASSWORD=<REPLACE_MINIO_ROOT_PASSWORD>
INTERNAL_SIGNING_SECRET=<REPLACE_INTERNAL_SIGNING_SECRET>
SVC_ATLAS_KEY=<REPLACE_SVC_ATLAS_KEY>
SVC_VOX_KEY=<REPLACE_SVC_VOX_KEY>
SVC_PULSE_KEY=<REPLACE_SVC_PULSE_KEY>
SVC_WORKFLOWS_KEY=<REPLACE_SVC_WORKFLOWS_KEY>
SVC_GATEWAY_KEY=<REPLACE_SVC_GATEWAY_KEY>
SVC_ADVAYA_KEY=<REPLACE_SVC_ADVAYA_KEY>
PULSE_API_KEYS=<REPLACE_PULSE_API_KEYS>
WORKFLOWS_API_KEYS=<REPLACE_WORKFLOWS_API_KEYS>
VOCX_FRONT_KEY=<REPLACE_VOCX_FRONT_KEY>
STT_API_KEY=<REPLACE_STT_API_KEY>

# ---- sign-in ----------------------------------------------------------------
# Google button on the login screen (use the same client ID in both issuer lists):
GOOGLE_SSO_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
# Accept Google tokens at the gateway/orchestrator (same id as above):
GATEWAY_OIDC_ISSUERS='https://accounts.google.com|<google-client-id>.apps.googleusercontent.com,http://dex:5556/dex|prism'
WORKFLOWS_OIDC_ISSUERS='https://accounts.google.com|<google-client-id>.apps.googleusercontent.com,http://dex:5556/dex|prism'
# Dex sign-in form posts same-origin through the edge:
UI_DEX_URL=https://prism.example.com

GATEWAY_OIDC_ALLOWED_DOMAINS=example.com
WORKFLOWS_OIDC_ALLOWED_DOMAINS=example.com
WORKFLOWS_AUTO_APPROVE=false

# ---- AI features (optional but used by CAM drafting / VocX extraction) ------
ANTHROPIC_API_KEY=<REPLACE_ANTHROPIC_API_KEY>
WORKFLOWS_ANTHROPIC_API_KEY=<REPLACE_WORKFLOWS_ANTHROPIC_API_KEY>

# ---- VocX voice capture -----------------------------------------------------
# The OAuth callback as the BROWSER reaches it (must also be registered in Google):
VOCX_REDIRECT_URI=https://prism.example.com/vocx/v1/auth/callback

# ---- Pulse New radar -----------------------------------------------------
PULSE_SMTP_HOST: <REPLACE_PULSE_SMTP_HOST>
PULSE_SMTP_PORT: <REPLACE_PULSE_SMTP_PORT>
PULSE_SMTP_USER: <REPLACE_PULSE_SMTP_USER>
PULSE_SMTP_PASS: <REPLACE_PULSE_SMTP_PASS>
PULSE_SMTP_FROM: <REPLACE_PULSE_SMTP_FROM>
PULSE_SMTP_FROM_NAME: <REPLACE_PULSE_SMTP_FROM_NAME>
PULSE_DISABLE_GDELT: <REPLACE_PULSE_DISABLE_GDELT>

# ---- edge / housekeeping (defaults shown; change only if needed) -----------
#EDGE_HTTP_PORT=80
#EDGE_HTTPS_PORT=443
#PGBACKUP_KEEP=14

# Remote Chitti connection.
CHITTI_GATEWAY_KEY='<REPLACE_CHITTI_GATEWAY_KEY>'
SVC_CHITTI_KEY='<REPLACE_SVC_CHITTI_KEY>'
GATEWAY_CHITTI_URL='https://<chitti-certificate-hostname>:8443'
GATEWAY_CHITTI_CA_FILE='/etc/prism/chitti-ca.crt'
