            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "X-User-Email",
            "value": "{{userEmail}}"
          },
          {
            "key": "X-User-Roles",
            "value": "Admin"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/people/resolve?name=arun.menon@evamfinance.com",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "people",
            "resolve"
          ],
          "query": [
            {
              "key": "name",
              "value": "arun.menon@evamfinance.com"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]));",
              "const r = (pm.response.json() || {}).resolved;",
              "if (r && r.id) pm.environment.set('demo_arun_personId', r.id); else pm.environment.unset('demo_arun_personId');",
              "pm.test('arun is on the roster', () => pm.expect(r, 'not resolved \u2014 did the sync request fail?').to.exist);"
            ]
          }
        }
      ]
    },
