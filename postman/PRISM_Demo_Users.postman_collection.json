    {
      "name": "POST /v1/internal/people/sync-access \u2014 roster catches up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "X-Actor",
