            "key": "X-User-Roles",
            "value": "Admin"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/internal/people/sync-access",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "internal",
            "people",
            "sync-access"
          ]
        },
        "description": "The register reconciles its people table FROM Access \u2014 dropdowns, scope and VocX all read this half."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]));",
              "const b = pm.response.json() || {};",
              "pm.test('roster holds the demo team', () => pm.expect(b.roster_total || 0).to.be.at.least(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /v1/people/resolve \u2014 arun",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "X-Actor",
            "value": "demo-users"
          },
