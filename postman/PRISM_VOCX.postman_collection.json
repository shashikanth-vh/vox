    {
      "name": "GET audio \u2014 playback for an archived recording",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Tenant",
            "value": "{{tenant}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "X-User-Email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vocx/v1/audio?ref={{vocxAudioRef}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "vocx",
            "v1",
            "audio"
          ],
          "query": [
            {
              "key": "ref",
              "value": "{{vocxAudioRef}}"
            }
          ]
        },
        "description": "MinIO refs answer {url: presigned} (signed against the PUBLIC MinIO endpoint \u2014 set vocxAudioRef from the preview's _meta.transcript_ref); volume refs stream audio/wav bytes. Refs outside the captures bucket/prefix are refused."
      }
    },
