            "v1",
            "reports"
          ],
          "query": [
            {
              "key": "rm",
              "value": "Priya"
            }
          ]
        },
        "description": "Every preview auto-saves a DRAFT; save marks it ready; commit marks it committed. The list survives device changes \u2014 no more localStorage."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ok', () => pm.expect(pm.response.code).to.eql(200));",
              "console.log(JSON.stringify(pm.response.json().reports, null, 2));"
            ]
          }
        }
      ]
    },
